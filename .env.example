# Example environment file: safe to commit.
#
# Copy to `.env` (git-ignored) to change local settings. Permit Horizon needs
# no secrets and no API keys: every source is a keyless public download.

# Where `hre fetch` caches raw downloads (never committed). Default: data/raw
DATA_DIR=data/raw

# Optional. Appended to the HTTP User-Agent so a data host that rate-limits
# scripted downloads can reach a human. Leave blank to omit.
HRE_CONTACT_EMAIL=
